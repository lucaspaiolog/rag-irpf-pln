# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# ===== LLM (geração da resposta) =====
LLM_PROVIDER=openai            # openai | anthropic | google | ollama
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Nomes de modelo: ajuste para um modelo disponível na sua conta/época.
OPENAI_LLM_MODEL=gpt-4o-mini
ANTHROPIC_LLM_MODEL=claude-haiku-5-5
GOOGLE_LLM_MODEL=gemini-3.8-flash
OLLAMA_LLM_MODEL=llama3.1

# Alguns modelos novos não aceitam "temperature". Se der erro, deixe vazio (LLM_TEMPERATURE=).
LLM_TEMPERATURE=0

# ===== Embeddings (vetorização) =====
EMBEDDING_PROVIDER=hf          # hf (local, grátis) | openai | google
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Pipeline =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
